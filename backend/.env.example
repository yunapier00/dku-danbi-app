# --- 필수 ---
# Gemini (langchain-google-genai가 환경변수에서 직접 읽음)
GOOGLE_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 선택 ---
# 로그인 후 토큰과 함께 돌아갈 프런트엔드 주소
FRONTEND_URL=http://localhost:5173

# SQLite 위치 (미설정 시 운영 기본값 sqlite:////app/data/danbi_chat.db)
# DATABASE_URL=sqlite:///./danbi_chat.db

# Chroma 벡터 DB 경로 (미설정 시 ./chroma_db_dd3, 실행 위치 기준)
# CHROMA_DB_PATH=./chroma_db_dd3

# CORS 허용 origin, 쉼표로 구분 (미설정 시 운영 프런트 주소 1개)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example

# 카카오 일일 질문 한도 (미설정 시 3)
# KAKAO_DAILY_LIMIT=3

# 크롤러: SSL 인증서 검증 (기본 true. 학교 서버 인증서 문제가 생길 때만 false)
# CRAWLER_VERIFY_SSL=true
# 학식 / 공지 크롤링 결과 캐시 시간(초). 0이면 캐시 끔
# MENU_CACHE_TTL_SECONDS=1800
# NOTICE_CACHE_TTL_SECONDS=300

# 카카오 웹훅 서명 검증. 설정하면 /api/kakao 요청에 아래 값과 같은 "X-Danbi-Kakao-Secret" 헤더가 없으면 401.
# 카카오 i 오픈빌더 > 스킬 > 스킬 서버 설정에서 같은 이름/값으로 커스텀 헤더를 등록해야 한다.
# 미설정 시(기본) 검증을 건너뛴다 — 기존 배포와 호환되지만, 운영에서는 설정을 권장한다.
# KAKAO_WEBHOOK_SECRET=
